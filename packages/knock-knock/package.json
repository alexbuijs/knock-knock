{
  "name": "@knock-knock/theme",
  "version": "0.1.0",
  "description": "Knock Knock, a Cohousing Intranet Wordpress Theme",
  "scripts": {
    "start": "APP_ENV=development vite",
    "build": "APP_ENV=production vite build",
    "test": "npm run stylelint && npm run eslint",
    "stylelint": "stylelint 'assets/scss/**/*.scss'",
    "eslint": "eslint 'assets/js/**/*'"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alexbuijs/knock-knock.git"
  },
  "keywords": [
    "wordpress",
    "theme",
    "cohousing"
  ],
  "browserslist": {
    "production": [
      "defaults"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  },
  "author": "Klopvaart Internet Team",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/alexbuijs/knock-knock/issues"
  },
  "homepage": "https://github.com/alexbuijs/knock-knock#readme",
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss"
    ],
    "customSyntax": "postcss-scss",
    "validate": [
      "assets/scss"
    ]
  },
  "eslintConfig": {
    "extends": [
      "standard",
      "plugin:react/recommended",
      "prettier"
    ],
    "plugins": [
      "react"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "postcss-scss": "^4.0.9",
    "sass": "1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.51.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@wordpress/dom-ready": "^4.56.0",
    "bootstrap": "^5.3.8",
    "delicious-hamburgers": "^1.2.3",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
